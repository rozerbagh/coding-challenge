# Copy to .env for local configuration. Never put real credentials in this file.

# Public browser URL. Used by the web app when a request runs in the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Internal service URL for server-side Next.js requests inside Docker Compose.
API_INTERNAL_BASE_URL=http://api:3001/api/v1

# API runtime configuration
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
FAKE_STORE_API_URL=https://fakestoreapi.com

# Local SMTP is provided by Mailpit in Docker Compose.
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SALES_EMAIL=sales@example.com
EMAIL_FROM=Product Catalogue <noreply@example.com>

# To use Resend instead of SMTP, set EMAIL_PROVIDER=resend and configure a
# Resend API key and sender address. Use a verified-domain sender for production.
# RESEND_API_KEY is for testing purpose i hav commited
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Fieldnote <noreply@your-verified-domain.example>

# Optional production email configuration (SMTP adapter; configure with a
# verified provider identity and secrets from your deployment secret manager).
# For AWS SES SMTP, use the region's SES SMTP endpoint and SES SMTP credentials.
# SMTP_HOST=email-smtp.<AWS_REGION>.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SALES_EMAIL=sales@your-domain.example
# EMAIL_FROM=Product Catalogue <noreply@your-domain.example>

# Reserved future production settings. The current MVP does not connect to a
# database and does not select an email provider from these variables.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/product_catalogue?sslmode=require
# DATABASE_SSL=true
# EMAIL_PROVIDER=ses-api
# AWS_REGION=us-east-1
# SES_FROM_EMAIL=noreply@your-domain.example
# SES_CONFIGURATION_SET=
# Use the AWS SDK default credential chain / workload IAM role for SES API
# access; do not put AWS access keys in this file.
